# Pengaturan lingkungan Mambetron Homestay
#
# Situs tetap bisa dibangun dan berjalan walau semua nilai di bawah kosong.
# Tanpa database, situs tampil dengan isi bawaan dan pemesanan online belum aktif.
# Isi nilainya di hPanel Hostinger (Websites, Node.js, Environment variables),
# atau salin berkas ini menjadi .env saat mencoba di komputer sendiri.
# Jangan pernah mengunggah .env yang sudah berisi kata sandi ke GitHub.

# Database MySQL dari hPanel (Databases, MySQL Databases).
# Di Hostinger host database biasanya localhost dengan port 3306.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Kata sandi awal semua akun panel pengelola di /admin. Pakai minimal 10 karakter.
# Panel dibuka dengan surel dan kata sandi. Surel pemilik diambil dari
# EMAIL_ADMIN di bawah, surel pengembang dari EMAIL_DEVELOPER.
ADMIN_PASSWORD=

# Kunci acak untuk menandatangani sesi masuk. Boleh dikosongkan, tetapi lebih
# aman diisi 32 karakter acak. Mengganti kunci ini membuat semua sesi keluar.
SESSION_SECRET=

# Alamat lengkap situs, contoh https://mambetronhomestay.com
# Dipakai untuk tautan di surel dan pratinjau tautan di media sosial.
SITE_URL=

# Surel untuk pemberitahuan pesanan dan kode ganti kata sandi panel.
# Kosongkan bila belum dipakai. Untuk surel Hostinger isinya
# SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_USER alamat kotak surel,
# dan SMTP_PASSWORD kata sandi kotak surel itu.
# EMAIL_FROM nama dan alamat pengirim, contoh Mambetron Homestay <halo@mambetronhomestay.com>.
# Alamat di dalamnya harus sama dengan SMTP_USER.
# EMAIL_ADMIN surel pemilik untuk masuk panel dan menerima pemberitahuan
# pesanan baru. Bila kosong, dipakai SMTP_USER.
# EMAIL_DEVELOPER surel pengembang yang juga boleh masuk panel, boleh lebih
# dari satu dipisah koma. Kode ganti kata sandi dikirim ke surel akun masing-masing.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_ADMIN=
EMAIL_DEVELOPER=
